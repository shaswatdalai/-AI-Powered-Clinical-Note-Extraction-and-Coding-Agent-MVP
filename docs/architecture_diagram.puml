@startuml Clinical_Architecture_Detailed
' ============================================================================
' DIAGRAM 1: DETAILED VERSION (Vertical / Portrait Layout)
' Flows top-to-bottom in a narrow column for vertical screen viewing.
' ============================================================================

skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam packageBorderThickness 2
skinparam arrowThickness 1.5
skinparam nodesep 20
skinparam ranksep 25

top to bottom direction

legend right
  |= Color |= Category |
  |<#E3F2FD> | Input / UI |
  |<#FFEBEE> | Safety |
  |<#F3E5F5> | Backend |
  |<#E8F5E9> | LLM (External) |
  |<#FFFDE7> | Retrieval |
  |<#E0F2F1> | Data Store |
  |<#E8EAF6> | Verification |
  |<#F5F5F5> | Logging |
end legend

' === INPUT ===
actor "Reviewer" as USER #1565C0
component "Raw Clinical Note" as RAW #90CAF9

' === BACKEND ===
component "FastAPI + Orchestrator" as ORCH #CE93D8

' === SAFETY ===
package "Safety (Local)" #FFEBEE {
    component "PII Masker\n(Regex + spaCy)" as PII #EF9A9A
    component "Injection Shield\n(XML Delimiters)" as INJ #EF9A9A
}

' === SECTIONS ===
component "Section Detector\n+ Offset Anchor\n(CC, HPI, Meds, Allergies,\nPE, A&P, Procedures)" as SECTIONS #CE93D8

' === EXTRACTION ===
package "Extraction" #E8F5E9 {
    component "Prompt Builder" as PROMPT #A5D6A7
    component "Groq Llama 3.3 70B\n**EXTRACTOR** (External)" as EXTR #66BB6A
}

' === VALIDATION ===
package "Pydantic V2 Validation" #F3E5F5 {
    component "Schema + Span Check\nT[start:end] == text" as PYD #CE93D8
    component "Validated Entities\n(Dx, Meds, Procedures,\nAllergies, Vitals)" as VALID #CE93D8
}

' === OFFLINE INDEXING ===
package "Offline Indexing (Startup)" #E0F2F1 {
    database "ICD-10 Dataset\n(~70K codes)" as ICD_DATA #80CBC4
    database "BM25 Index" as BM25_IDX #4DB6AC
    database "ChromaDB Vectors" as CHROMA #4DB6AC
}

' === RUNTIME RETRIEVAL ===
package "Hybrid ICD-10 Retrieval" #FFFDE7 {
    component "BM25 Lexical\nSearch" as BM25 #FFF176
    component "Semantic Vector\nSearch (ChromaDB)" as SEM #FFF176
    component "RRF Fusion +\nConfidence Filter\n(≥0.70 or abstain)" as RRF #FFD54F
}

' === VERIFICATION ===
package "Independent Verification" #E8EAF6 {
    component "Gemini 2.0 Flash\n**VERIFIER** (External)\n\nChecks: spans, status,\ncontradictions, recall,\nICD-10 fitness" as VERIFIER #7986CB
}

' === RECONCILIATION ===
package "Reconciliation" #E8EAF6 {
    component "**ACCEPT**" as ACCEPT #66BB6A
    component "**REJECT**" as REJECT #EF5350
    component "**ABSTAIN**\n→ Human Review" as ABSTAIN #FFA726
}

' === UI ===
package "Reviewer Cockpit (HTML/CSS/JS)" #E3F2FD {
    component "Note + Span Highlights\nEntity Table + ICD Cards\nTrace Viewer + JSON Export" as UI #BBDEFB
}

' === LOGGING ===
component "Audit Log (JSONL)" as LOG #E0E0E0

' ============================================================================
' DATA FLOW
' ============================================================================
USER -down-> RAW : "submits"
RAW -down-> ORCH : "raw text"
ORCH -down-> PII : "raw text"
PII -down-> INJ : "redacted text"
INJ -down-> SECTIONS : "safe text"
SECTIONS -down-> PROMPT : "sections + offsets"
PROMPT -down-> EXTR : "prompt"
EXTR -down-> PYD : "raw JSON"
PYD -down-> VALID : "validated"
PYD ..> ORCH : "retry on failure\n(N ≤ 2)"

VALID -down-> BM25 : "diagnosis names"
VALID -down-> SEM : "diagnosis names"
BM25 -left-> BM25_IDX : "lookup"
SEM -left-> CHROMA : "vector search"
BM25 -down-> RRF : "lexical ranks"
SEM -down-> RRF : "semantic ranks"

ICD_DATA -down-> BM25_IDX : "one-time index"
ICD_DATA -down-> CHROMA : "one-time embed"

VALID -down-> VERIFIER : "entities + spans"
RRF -down-> VERIFIER : "ICD candidates"

VERIFIER -down-> ACCEPT
VERIFIER -down-> REJECT
VERIFIER -down-> ABSTAIN

ACCEPT -down-> UI : "accepted"
ABSTAIN -down-> UI : "flagged"
USER <-up- UI : "review & export"

EXTR ..> LOG
VERIFIER ..> LOG
RRF ..> LOG

@enduml


' ############################################################################
' ############################################################################
' SEPARATOR — SECOND DIAGRAM BELOW (SIMPLIFIED EXECUTIVE VERSION)
' ############################################################################
' ############################################################################


@startuml Clinical_Architecture_Simple
' ============================================================================
' DIAGRAM 2: SIMPLIFIED EXECUTIVE VERSION
' Minimal boxes, same core flow, for quick overview slides.
' ============================================================================

skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam arrowThickness 2
skinparam nodesep 30
skinparam ranksep 30
skinparam componentStyle rectangle

top to bottom direction

actor "Reviewer" as USER #1565C0

rectangle "**Raw Clinical Note**" as RAW #90CAF9

rectangle "**PII Masking + Safety**\n(Local: Regex + spaCy + XML Shield)" as SAFETY #EF9A9A

rectangle "**Section Detection**\n(CC, HPI, Meds, Allergies, PE, A&P)\n+ Character Offset Preservation" as SECTIONS #CE93D8

rectangle "**Structured Extraction**\nGroq Llama 3.3 70B\n+ Pydantic V2 Validation" as EXTRACT #66BB6A

rectangle "**Hybrid ICD-10 Retrieval**\nBM25 + ChromaDB + RRF\n(≥0.70 → candidates | <0.70 → abstain)" as RETRIEVAL #FFD54F

rectangle "**Independent Verification**\nGemini 2.0 Flash\n(Spans, Status, Contradictions, Recall)" as VERIFY #7986CB

rectangle "**Reconciliation**" as RECON #9FA8DA {
    rectangle "ACCEPT" as A #66BB6A
    rectangle "REJECT" as R #EF5350
    rectangle "ABSTAIN" as AB #FFA726
}

rectangle "**Reviewer Cockpit**\nSpan Highlights · Entity Table\nTrace Viewer · JSON Export" as UI #BBDEFB

database "Audit Log\n(JSONL)" as LOG #E0E0E0

' === FLOW ===
USER -down-> RAW
RAW -down-> SAFETY : "raw text"
SAFETY -down-> SECTIONS : "safe redacted text"
SECTIONS -down-> EXTRACT : "sections + offsets"
EXTRACT -down-> RETRIEVAL : "validated entities"
EXTRACT -down-> VERIFY : "entities + spans"
RETRIEVAL -down-> VERIFY : "ICD-10 candidates"
VERIFY -down-> RECON : "verdicts"
A -down-> UI : "accepted"
AB -down-> UI : "flagged for review"
UI -up-> USER : "review & export"

EXTRACT ..> LOG
VERIFY ..> LOG
RETRIEVAL ..> LOG

note right of SAFETY
  PII never leaves
  localhost. All masking
  runs before external
  API calls.
end note

note right of VERIFY
  Verifier never sees
  extractor reasoning.
  Independent check.
end note

note right of AB
  Abstention = intentional
  safety mechanism, not
  a system failure.
end note

@enduml
